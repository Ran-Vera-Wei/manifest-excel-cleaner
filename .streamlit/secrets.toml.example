# Copy this file to secrets.toml for local use, or add the same section in
# Streamlit Community Cloud > App settings > Secrets. Keep actual passwords
# out of source control.

[manifest_passwords]
EZE = "paste-password-for-EZE"
GUA = "paste-password-for-GUA"
SAL = "paste-password-for-SAL"
LIM = "paste-password-for-LIM"
SJO = "paste-password-for-SJO"
VCP = "paste-password-for-VCP"
SCL = "paste-password-for-SCL"
POS = "paste-password-for-POS"
SAP = "paste-password-for-SAP"
UIO = "paste-password-for-UIO"
